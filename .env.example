# Google Ads API access (server-side secret)
GOOGLE_ADS_DEVELOPER_TOKEN=replace-with-google-ads-developer-token

# OAuth 2.0 Web Application from Google Cloud Console
GOOGLE_ADS_MCP_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_ADS_MCP_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Local development
GOOGLE_ADS_MCP_BASE_URL=http://localhost:8080
PORT=8080
OAUTH_STORAGE_BACKEND=memory
OAUTH_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters

# Optional Google Ads manager account, exactly 10 digits without hyphens
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# Maximum rows returned by one search call (1-100000; default 5000)
GOOGLE_ADS_MCP_MAX_ROWS=5000

# Railway production: use the existing private Redis service.
# Set OAUTH_STORAGE_BACKEND=redis and use a Railway reference for REDIS_URL.
# REDIS_URL=redis://default:password@localhost:6379/0
# OAUTH_STORAGE_ENCRYPTION_KEY=replace-with-a-fernet-key

# Optional override. Production defaults to Claude's OAuth callback only.
# MCP_ALLOWED_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback
